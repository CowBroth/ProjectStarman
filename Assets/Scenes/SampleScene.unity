  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6f3a8ebb15f0cb54884e8d834a38cc02, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  dialogue:
    name: Sarah
    sentences:
    - Sorry, Ewan. You can't go into the woods today.
    - One, farmer John planted new seeds, and he poked Geoff in the butt with a pitchfork
      for walking on the soil!
    - Two... Ewan, you ever hear the story of the Warden of Watauga Woods?
    - They say it only preys on kids that don't do their homework and eat garbage
      all day...
    - What's that face for? I'm just looking out for ya!
