  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6f3a8ebb15f0cb54884e8d834a38cc02, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  dialogue:
    name: Geoff
    sentences:
    - Hey, little buddy.
    - I've been trying to run for mayor, but because I lack any experience whatsoever,
      they won't lemme in!
    - But the old fart we got as mayor is toootally fine, right?
    - Because we definitely want the town to be ran by someone who's gonna keel over
      any minute.
    - ...and thaaat's politics!
